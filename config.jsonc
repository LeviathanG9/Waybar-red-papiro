{
	"layer": "top",
	"position": "bottom",
	"height": 32,

	"modules-left": [
		"custom/leviathan",
		"cpu",
		"memory",
		"wireplumber",
		"network",
		"custom/notification",
		"custom/vesktop",
		"custom/steam"
	],
	
	"modules-center": [
		"clock"
	],
	
	"modules-right": [
		"hyprland/workspaces"
	],

	"clock": {
		"format": "󰥔 {:%H:%M}",
		"tooltip-format": "<tt><small>{calendar}</small></tt>",
		"calendar": {
		        "mode": "month",
		        "weeks-pos": "right",
		
		        "format": {
		            "months": "<span color='#730000'><b>{}</b></span>",
		            "weekdays": "<span color='#C4C0B5'><b>{}</b></span>",
		            "today": "<span background='#730000' foreground='#000000'><b>{}</b></span>"
		        }
		    }
	},

	"cpu": {
		"format": "  {usage}% ",
		"interval": 1
	},
	
	"hyprland/workspaces": {
		"format": "{icon}",
		"persistent-workspaces": {
			"*":10
		},
		
		"format-icons": {
			"1": "一",
			"2": "二",
			"3": "三",
			"4": "四",
			"5": "五",
			"6": "六",
			"7": "七",
			"8": "八",
			"9": "九",
			"10": "十"
		}
	},

	"memory": {
		"format": "  {used}G ",
		"interval": 1
	},

	"network": {
	    "format-wifi": " {icon} {essid} ",
	    "format-ethernet": " 󰈀 Ethernet ",
	    "format-disconnected": " 󰤭 Sin red ",
	    "format-disabled": "  Modo Avión",
	    "tooltip-format": "{ifname}\n{ipaddr}",
	    "on-click": "~/.config/hypr/scripts/WiFi-menu.sh",
		"format-icons": [
			" 󰤟 ",
			" 󰤢 ",
			" 󰤥 ",
			" 󰤨 "
		]
	},

	"wireplumber": {
	    "format": " {icon} {volume}% ",
	    "format-muted": " 󰸈 ",
	    "format-icons": [
	        "  ",
	        "  ",
	        "  "
	    ],
	    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
	    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
	    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
	},

	"custom/leviathan": {
		"format": "  Arch Linux ",
		"on-click": "~/.config/hypr/scripts/optimizacion.sh",
		"on-click-right": "~/.config/hypr/scripts/power-confirm.sh"
	},

	"custom/notification": {
		"format": " 󰂚 ",
		"on-click": "swaync-client -t",
		"on-click-right": "swaync-client -d",
		"tooltip": true
	},

	"custom/steam": {
		"format": "  ",
		"on-click": "~/.config/hypr/scripts/focus.sh steam",
		"on-click-right": "killall -TERM steam",
		"tooltip": "Steam"
	},

	"custom/vesktop": {
		"format": "  ",
		"on-click": "~/.config/hypr/scripts/focus.sh vesktop",
		"on-click-right": "pkill -9 vesktop",
		"tooltip": "Vesktop"
	}
}
